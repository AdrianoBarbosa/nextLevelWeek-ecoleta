{
  "expo": {
    "name": "Ecoleta",
    "slug": "ecoleta",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Precisamos da sua localização para mostrar os pontos de coleta próximos."
        }
      ],
      "expo-mail-composer",
      "expo-font",
      "expo-asset"
    ]
  }
}
